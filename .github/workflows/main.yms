name: Build Brain Power Kids APK
on: workflow_dispatch

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Copy web files into www
        run: |
          mkdir -p www
          rsync -a --exclude='.git' --exclude='.github' \
            --exclude='www' --exclude='node_modules' \
            --exclude='android' ./ www/

      - name: Create Android project
        run: |
          npm init -y
          npm i @capacitor/core@6 @capacitor/cli@6 @capacitor/android@6
          npx cap init "Brain Power Kids" com.successkings.brainpowerkids --web-dir=www
          npx cap add android
          npx cap sync android

      - name: Build APK
        working-directory: android
        run: |
          chmod +x gradlew
          ./gradlew assembleDebug

      - uses: actions/upload-artifact@v4
        with:
          name: BrainPowerKids-APK
          path: android/app/build/outputs/apk/debug/app-debug.apk
